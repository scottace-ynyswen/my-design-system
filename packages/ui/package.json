{
  "name": "@my-ds/ui",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build":     "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "dev":       "tsup src/index.ts --format esm,cjs --dts --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "lint":      "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "react":              ">=18",
    "react-native":       ">=0.73",
    "nativewind":         "^4.0.0",
    "tailwindcss":        "^3.4.0"
  },
  "dependencies": {
    "@gluestack-ui/react":          "^0.1.3",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "class-variance-authority":     "^0.7.1",
    "clsx":                         "^2.1.1",
    "tailwind-merge":               "^2.5.4"
  },
  "devDependencies": {
    "@types/react":        "^18.3.12",
    "@types/react-native": "^0.73.0",
    "react":               "18.3.1",
    "react-native":        "0.76.5",
    "nativewind":          "^4.1.23",
    "tailwindcss":         "^3.4.15",
    "tsup":                "^8.3.5",
    "typescript":          "^5.6.3"
  }
}
